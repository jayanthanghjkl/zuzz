# ZUZZ configuration template. Copy to .env and fill in real values.
# .env is git-ignored and must never be committed.
#
# Aliases accepted by the code, so either name works:
#   HUGGINGFACE_API_KEY  <-> HF_API_KEY
#   COLAB_API_URL        <-> COLAB_URL <-> NGROK_URL
#   OLLAMA_HOST          <-> OLLAMA_URL
#   ZUZZ_PORT            <-> WEB_PORT

# --- Brain ---
LOCAL_MODEL_FAST=qwen2.5-coder:1.5b
LOCAL_MODEL_SMART=qwen2.5-coder:3b
LOCAL_VISION_MODEL=moondream
OLLAMA_HOST=http://localhost:11434
CLOUD_MODEL=groq/openai/gpt-oss-120b

# --- Corpus Callosum (cloud providers) ---
# Any subset is fine. With none set, ZUZZ runs local-only.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
HUGGINGFACE_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.8-27b:free
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
# Colab is keyless: its ngrok URL is the credential, and changes each session.
COLAB_API_URL=
COLAB_MODEL=llama3.1:8b

# --- Communication (Phase 8) ---
TELEGRAM_BOT_TOKEN=
NTFY_TOPIC=

# --- Brainstem ---
ZUZZ_HOST=127.0.0.1
ZUZZ_PORT=8080
LOG_LEVEL=INFO

# --- Hypothalamus ---
MAX_VRAM_MB=4608
MAX_AGENT_RAM_MB=3072
MODEL_UNLOAD_SECONDS=60
